# =============================================================================
# BioAgents — environment configuration
#
# Copy this file to `.env` and fill in the values you actually need. Only the
# LLM provider block is strictly required; everything else unlocks an optional
# tool or external MCP server.
#
#   cp .env.template .env
#   docker compose up --build
# =============================================================================

# ---------------------------------------------------------------------------
# LLM provider (pick one: openai | gemini | ollama | openrouter)
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
# Optional shared model for the selected provider. A provider-specific model wins.
LLM_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_RATE_LIMIT=5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ollama (only when LLM_PROVIDER=ollama). Use host.docker.internal from inside
# the container to reach a local Ollama daemon running on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=

# ---------------------------------------------------------------------------
# Runtime behaviour
# ---------------------------------------------------------------------------
# Port the FastAPI UI binds on the host (container always listens on 8000).
BIOAGENTS_PORT=8000

# Number of uvicorn workers. Bump for concurrent traffic.
WEB_CONCURRENCY=1

# Transient wrapper-generation failures/empty replies: 1-3 attempts, within workflow budget.
BIOAGENTS_TOOL_WRAPPER_ATTEMPTS=2

# When "true", the coder/ml/dl agents execute code in-process using
# smolagents.LocalPythonExecutor. When "false", the DockerExecutor spawns
# nested containers lazily using an existing shared image or prebuilt per-agent images.
# In Compose, also enable docker-compose.sandbox.yml (Linux Docker hosts).
# Missing images fail explicitly; Docker failure never falls back to host execution.
USE_LOCAL_EXECUTOR=true
# Optional exact prebuilt image/tag. Empty uses the shared recipe tag, then legacy images.
BIOAGENTS_SANDBOX_IMAGE=
# Opt in to building a missing shared image during first use (default false).
BIOAGENTS_SANDBOX_ALLOW_BUILD=false
# Expose GPUs to nested sandbox containers only when explicitly enabled.
BIOAGENTS_SANDBOX_GPU=false
# auto lets Docker select a configured GPU runtime. NVIDIA hosts may use cdi or nvidia.
BIOAGENTS_SANDBOX_GPU_DRIVER=auto

# Per-code execution deadline in seconds; independent of agent max_steps.
# Timeout restarts the kernel and restores tools; computed in-memory variables are lost.
# Takes precedence over the legacy BIOAGENTS_CODER_EXEC_TIMEOUT alias.
# If neither setting exists, the upstream default is 1800 seconds.
BIOAGENTS_CODE_EXECUTION_TIMEOUT_SEC=300

# Linux group ID owning /var/run/docker.sock (stat -c %g /var/run/docker.sock).
DOCKER_GID=

# ---------------------------------------------------------------------------
# Observability — LangSmith (optional)
# ---------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=bioagents

# ---------------------------------------------------------------------------
# ToolUniverse MCP integrations (optional, leave blank to disable)
# ---------------------------------------------------------------------------
BOLTZ_MCP_SERVER_HOST=
EXPERT_FEEDBACK_MCP_SERVER_URL=
HF_TOKEN=
TXAGENT_MCP_SERVER_HOST=
USPTO_API_KEY=
USPTO_MCP_SERVER_HOST=
